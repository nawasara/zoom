{
    "name": "nawasara/zoom",
    "description": "Zoom meeting management dashboard for Nawasara \u2014 user management, meeting CRUD, recording management, and webhook integration with DB-cached snapshots and queue-backed mutations.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "zoom",
        "meeting",
        "video-conference",
        "recording",
        "api"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/zoom/issues",
        "source": "https://github.com/nawasara/zoom"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Zoom\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-permission": "^6.0",
        "nawasara/ui": "*",
        "nawasara/keycloak": "*",
        "nawasara/search": "*",
        "nawasara/sync": "*",
        "nawasara/vault": "*",
        "nawasara/registry": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Zoom\\ZoomServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
